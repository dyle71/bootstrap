[Unit]
Description=llama-server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/llama-server \
  --models-preset %h/Llama/models.ini --models-max 1 \
  --host 127.0.0.1 --port 8080 \
  --jinja \
  -fa on \
  -c 65536 --parallel 1 --no-context-shift \
  --cache-reuse 256 \
  --reasoning-format auto \
  --slots --metrics
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
