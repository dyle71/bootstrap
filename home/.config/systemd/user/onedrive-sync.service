[Unit]
Description=OneDrive bisync HTL-Villach
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
ExecStart=/home/dyle/Applications/sync-onedrive
Restart=always
RestartSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=onedrive-sync

[Install]
WantedBy=default.target
